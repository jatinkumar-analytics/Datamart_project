		lineageTag: 57833476-ba98-4337-a784-8f9251464297

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Net Pay per Employee' =
			
			DIVIDE (
			    [Net Payroll],
			    DISTINCTCOUNT ( fact_payroll[employee_key] )
			)
