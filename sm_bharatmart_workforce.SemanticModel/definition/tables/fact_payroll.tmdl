	measure 'Gross Payroll' =
			
			SUM ( fact_payroll[gross_pay] )
		lineageTag: 168ee2c5-b259-4e34-819b-88de5a24b2eb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Payroll' =
			
