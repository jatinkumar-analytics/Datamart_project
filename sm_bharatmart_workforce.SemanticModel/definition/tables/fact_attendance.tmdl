table fact_attendance
	lineageTag: f370adca-15d6-484b-bb6c-d3cc956f63fd
	sourceLineageTag: [workforce].[fact_attendance]

	measure 'Worked Hours' =
			
			SUM ( fact_attendance[worked_hours] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2e205daa-3d2a-4cab-a7d8-e2fcf487bbec

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en"}

	measure 'Attendance Utilization %' =
			
			DIVIDE (
			    SUM ( fact_attendance[worked_hours] ),
			    SUM ( fact_attendance[scheduled_hours] )
			)
		lineageTag: 6f8a281c-4733-48cc-98cc-4ab36c5cfd6d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overtime Rate %' =
			
			DIVIDE (
			    SUM ( fact_attendance[overtime_hours] ),
			    [Worked Hours]
			)
		lineageTag: ed89d203-8fde-4eeb-9fbb-7013b77d7bb8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

