table fact_sales
	lineageTag: a9d45b24-9edc-40d2-8ba5-d5aba117e0a7
	sourceLineageTag: [sales].[fact_sales]

	measure 'Total revenue' = SUM(fact_sales[net_amount])
		lineageTag: 0a96e160-7f0b-4974-8228-7c0a6478aac1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Sales' =
			
			SUM ( fact_sales[gross_amount] )
		lineageTag: 7489e033-07be-458e-a554-d8fec4bbe1a0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Discount' =
			
			SUM ( fact_sales[discount_amount] )
		lineageTag: 4510dfc0-4033-48ad-8ac9-a6df6dd4953a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost' =
			
			SUM ( fact_sales[cost_amount] )
		lineageTag: 1a3c1406-bfcc-4fa5-955d-4c782cb1329f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin' =
			
			SUM ( fact_sales[margin] )
		lineageTag: 751b56c4-3acb-42ec-b3cc-c3f65a9548f8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' =
			
			DIVIDE (
			    [Gross Margin],
			    [Total Revenue]
			)
		lineageTag: f43926be-2a6e-475f-9957-0fcc8bf7b01f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Units Sold' =
			
			SUM ( fact_sales[quantity] )
		formatString: 0
		lineageTag: d7f0f3eb-bd30-47b0-a31c-21d8abb80cdf

		changedProperty = Name

	measure 'Order Count' =
			
			DISTINCTCOUNT ( fact_sales[order_number] )
		formatString: 0
		lineageTag: bf17dbd7-9c13-45e5-bd8b-2665014cd353

		changedProperty = Name

	measure 'customer count' = DISTINCTCOUNT(fact_sales[customer_key])
		formatString: 0
		lineageTag: f8aa8959-3a48-49b0-9cde-08932aff0aa7

		changedProperty = Name

	measure AOV = DIVIDE([Total revenue],[Order Count])
		lineageTag: cb870935-9cac-4b00-b5f9-9519968fc412

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg selling price' = DIVIDE([Total revenue],[Units Sold])
		lineageTag: f268c830-d112-4125-90fb-9e65f7648ba4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Discount rate %' = DIVIDE([Total Discount],[Gross Sales])
		lineageTag: 8539cf6e-6923-4fbe-9f43-dbdd3fda3a1b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YTD' = TOTALYTD([Total revenue],dim_date[full_date])
		lineageTag: 87613a45-9704-4b8c-8daa-594bd80ed21f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promoted Revenue' =
			
			CALCULATE (
			    [Total Revenue],
			    fact_sales[promotion_key] <> BLANK ()
			)
		lineageTag: 59e69fe8-8234-443f-aa86-39d1c7b7f777

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promoted Revenue %' =
			
			DIVIDE (
			    [Promoted Revenue],
			    [Total Revenue]
			)
		lineageTag: 3d60d3bc-1dd3-43c4-904c-0b7dfdb9f43f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

